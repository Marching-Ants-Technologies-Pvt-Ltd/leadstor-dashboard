# Leadstor CRM Frontend — Environment Variables
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Generated from a source scan of `process.env.*` usage (2026-11-04).
#
# Next.js loading rules:
#   - Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
#   - All others are server-only (Route Handlers, next-auth, API proxies).

# ---------------------------------------------------------------------------
# Public (client-side / browser) — shipped in the JS bundle
# ---------------------------------------------------------------------------

# Leadstor / dashboard PHP REST API base URL (all `/services/*` calls go here).
# Local:  http://localhost:8000
# Prod:   https://api.leadstor.in
NEXT_PUBLIC_LEADSTOR_REST=

# Facebook App ID used by the Facebook JS SDK (integration/facebook).
NEXT_PUBLIC_FB_APP_ID=

# Google reCAPTCHA v3 site key (public half).
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ---------------------------------------------------------------------------
# Server-only — never exposed to the browser
# ---------------------------------------------------------------------------

# ConceptNinjas API base URL (auth bridge + onboarding proxy).
# Used by: lib/conceptninjas/oauth.js, api/conceptninjas/* route handlers.
CONCEPTNINJAS_URL=

# Contact-form ingestion endpoint (api/conceptninjas/lead-form).
CONTACT_FORM_URL=

# NextAuth — Google OAuth provider
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — Facebook OAuth provider
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# NextAuth JWT signing secret (generate a long random string).
JWT_SECRET=

# Google reCAPTCHA v3 secret key (server-side verification).
RECAPTCHA_SECRET_KEY=

# ---------------------------------------------------------------------------
# CI / Deployment (NOT part of `.env`)
# ---------------------------------------------------------------------------
# VERCEL_TOKEN is a Bitbucket Pipelines repository variable used by
# bitbucket-pipelines.yml to deploy `master` to Vercel. Set it in
# Bitbucket → Repository settings → Pipelines → Repository variables.
